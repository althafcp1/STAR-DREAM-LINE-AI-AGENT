# Environment Configuration for AI Travel Planning Agent
APP_ENV=development
APP_DEBUG=true
PORT=8000
HOST=127.0.0.1

# LLM Configuration (Google Gemini API)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# External APIs
OPENWEATHER_API_KEY=your_openweather_api_key_here
GOOGLE_MAPS_API_KEY=your_google_places_api_key_here

# Agent Safety Controls (📘 L7)
MAX_AGENT_STEPS=10
REQUIRE_CONFIRMATION_THRESHOLD_USD=500.0
ENABLE_AUDIT_LOG=true

